# Road Desk · the call and dossier service. Copy to .env. One value is required: your OpenRouter key.
OPENROUTER_API_KEY=

# Everything below has a working default.
# The control-room app, for the live pull (clock, telemetry, timeline, cases, helpdesk messages):
#APP_URL=http://127.0.0.1:3000
#PORT=8799
# Speech for simulated calls (ElevenLabs over OpenRouter, the same voices as the line): 1 on, anything else off.
#SIM_TTS=1
# Models (OpenRouter names): the pro model reasons over dossiers and speaks as Mira; the flash model rewrites and role-plays.
#REASON_MODEL=deepseek/deepseek-v4-pro
#CALLEE_MODEL=deepseek/deepseek-v4.1-flash
#BRIEF_MODEL=deepseek/deepseek-v4.1-flash
#SUGGEST_MODEL=deepseek/deepseek-v4.1-flash
#TTS_MODEL=elevenlabs/eleven-v4-turbo
