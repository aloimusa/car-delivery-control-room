# Road Desk · the control-room app. Copy to .env. One value is required: your OpenRouter key.
OPENROUTER_API_KEY=

# Everything below has a working default and can stay as it is.
# Postgres and the local object store, as docker compose starts them:
DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments
# The call and dossier service (dossier/), if it runs on another port or host:
#CALL_SERVICE_URL=http://127.0.0.1:8799

# Models (OpenRouter names). Two DeepSeek models do the work; Haiku reads photos and screens driver messages.
#AGENT_MODEL=deepseek/deepseek-v4-pro
#SIM_DRIVER_MODEL=deepseek/deepseek-v4.1-flash
#DRIVABILITY_MODEL=anthropic/claude-haiku-5.5
#VISION_MODEL=anthropic/claude-haiku-5.5
#AGENT_EFFORT_FAST=low
#AGENT_EFFORT_DEEP=medium

# The simulation: the clock starts at the dataset snapshot; the heartbeat keeps telemetry, timers and the autopilot's
# calls running with no tab open; the autopilot places at most this many model-played calls an hour.
#SIM_NOW=2026-10-21T09:00:00Z
#SIM_DRIVER_ENABLED=true
#HEARTBEAT_SECONDS=20
#AUTOPILOT=on
#AUTOPILOT_PAUSE_SECONDS=120
#AUTOPILOT_MAX_CALLS_PER_HOUR=10
